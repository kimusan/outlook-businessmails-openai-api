{
  "name": "office-addin-taskpane-react",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimusan/outlook-businessmails-openai-api.git"
  },
  "author": "Kim Schulz (based on work by Matteo Pagani)",
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "npm run build:web",
    "build:web": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "host:start": "node local-host/sea-main.cjs",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "local:runtime": "node scripts/prepare-local-runtime.cjs",
    "local:manifest": "node scripts/prepare-manifest-local.cjs",
    "local:certs": "node scripts/prepare-local-certs.cjs",
    "local:prepare": "npm run build:web && npm run local:runtime && npm run local:manifest && npm run local:certs",
    "sea:config": "node scripts/write-sea-config.cjs",
    "sea:blob": "node --experimental-sea-config ./.sea/sea-config.json",
    "sea:package": "node scripts/package-sea.cjs",
    "package:local:win": "npm run local:prepare && npm run sea:config && npm run sea:blob && npm run sea:package",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-startup.ps1 -InstallDir release/local-host",
    "startup:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/remove-startup.ps1",
    "cert:trust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/trust-local-cert.ps1 -InstallDir release/local-host",
    "prettier": "office-addin-lint prettier",
    "start": "office-addin-debugging start manifest.xml --no-debug",
    "start:desktop": "office-addin-debugging start manifest.xml desktop --no-debug",
    "start:web": "office-addin-debugging start manifest.xml web --no-debug",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@fluentui/react": "^8.52.3",
    "core-js": "^3.9.1",
    "es6-promise": "^4.2.8",
    "openai": "^3.1.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "regenerator-runtime": "^0.13.7"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/preset-typescript": "^7.13.0",
    "@types/office-js": "^1.0.256",
    "@types/office-runtime": "^1.0.23",
    "@types/react": "^17.0.39",
    "@types/react-dom": "^17.0.11",
    "@types/react-hot-loader": "^4.1.1",
    "@types/webpack": "^4.4.34",
    "@types/webpack-dev-server": "^4.1.0",
    "acorn": "^8.5.0",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^9.0.1",
    "eslint-plugin-office-addins": "^2.1.4",
    "eslint-plugin-react": "^7.28.0",
    "file-loader": "^6.2.0",
    "html-loader": "^4.1.0",
    "html-webpack-plugin": "^5.5.0",
    "less": "^3.9.0",
    "less-loader": "^10.0.1",
    "office-addin-cli": "^2.0.6",
    "office-addin-debugging": "^6.0.6",
    "office-addin-dev-certs": "^2.0.6",
    "office-addin-lint": "^3.0.6",
    "office-addin-manifest": "^2.1.2",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^3.0.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.3.5",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.8.0",
    "webpack-dev-server": "4.7.4"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "ie 11"
  ]
}
